# Server-side configuration for /api/contact (web/api/contact.js).
#
# These are read by the serverless function, never by the browser — do not
# prefix them with VITE_, which would inline them into the client bundle.
# Set the real values in the Vercel project settings (Production, Preview and
# Development), and copy this file to web/.env.local for `vercel dev`.

# Resend API key with send permission — https://resend.com/api-keys
RESEND_API_KEY=

# Sender address, on a domain verified with the provider. Must not be a free
# mailbox (gmail.com and the like) or DMARC will reject the mail.
CONTACT_FROM_EMAIL="Havencrest Website <info@yourdomain.com>"

# Where enquiries land. Comma-separated for more than one recipient.
CONTACT_TO_EMAIL=